# Copy to a local shell snippet or source directly before running:
#   set -a
#   source templates/deploy/npm-publish.env.example
#   set +a
#   pnpm deploy:npm:plan

VIBLY_DEPLOY_TARGET=npm

# Optional publish settings used by the built-in npm profile.
NPM_PUBLISH_ACCESS=public
NPM_PUBLISH_TAG=latest

# Preferred auth for npm publish. Access Tokens avoid interactive OTP flows.
# The deploy script will also mirror NPM_TOKEN -> NODE_AUTH_TOKEN automatically.
NPM_TOKEN=npm_xxxxxxxxxxxxxxxxxxxx
# NODE_AUTH_TOKEN=npm_xxxxxxxxxxxxxxxxxxxx

# Built-in npm profile currently covers:
# - concord        -> publishes @vibly-ai/concord-* packages
# - vibly-client   -> publishes @vibly-ai/client
# - vibly-coordinator-http-contract -> publishes @vibly-ai/coordinator-http-contract

# Example:
# pnpm deploy:npm -- --only=concord,vibly-client,vibly-coordinator-http-contract
