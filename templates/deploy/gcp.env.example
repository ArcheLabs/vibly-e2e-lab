# Copy to a local shell snippet or source directly before running:
#   set -a
#   source templates/deploy/gcp.env.example
#   set +a
#   pnpm deploy:gcp:plan

VIBLY_DEPLOY_TARGET=production

# Required for the built-in GCP profile.
GCP_PROJECT_ID=your-gcp-project
GCP_REGION=asia-east1
GCP_VM_ZONE=asia-east1-b

# Cloud Run defaults
GCP_RUN_ALLOW_UNAUTHENTICATED=true

# Coordinator runs on Cloud Run, but production still needs an external Postgres
# (typically Cloud SQL). The built-in deploy hook now requires an explicit
# env yaml file plus an explicit Cloud SQL instance binding, instead of hiding
# production DB wiring in free-form FLAGS.
# `GCP_VIBLY_COORDINATOR_ENV_FILE` is resolved relative to the
# `vibly-coordinator` repo unless you pass an absolute path.
GCP_VIBLY_COORDINATOR_SERVICE=vibly-coordinator
GCP_VIBLY_COORDINATOR_ENV_FILE=templates/cloud-run.env.yaml.example
GCP_VIBLY_COORDINATOR_CLOUDSQL_INSTANCE=your-gcp-project:asia-east1:vibly-coordinator-pg
GCP_VIBLY_COORDINATOR_FLAGS=

# Console can also run on Cloud Run when you want Auth.js proxy mode.
GCP_VIBLY_CONSOLE_SERVICE=vibly-console
GCP_VIBLY_CONSOLE_FLAGS=

# Vibly chain is best hosted on a VM. Two built-in modes are supported:
# - upload: build locally, scp the binary, restart systemd
# - remote-build: build on the VM, then restart systemd
GCP_VIBLY_CHAIN_VM=vibly-chain-vm
GCP_VIBLY_CHAIN_ZONE=
GCP_VIBLY_CHAIN_SERVICE=vibly-solo-node
GCP_VIBLY_CHAIN_DEPLOY_MODE=upload
GCP_VIBLY_CHAIN_BINARY_PATH=./target/release/vibly-solo-node
GCP_VIBLY_CHAIN_REMOTE_STAGING_PATH=/tmp/vibly-solo-node
GCP_VIBLY_CHAIN_REMOTE_BIN=/usr/local/bin/vibly-solo-node
GCP_VIBLY_CHAIN_REMOTE_DIR=/opt/vibly/vibly-chain

# Indexer is not serverless: it needs Docker Compose (Postgres + SubQuery).
# Deploy it to a VM, normally beside the chain or on a private peer VM.
# Bootstrap a fresh VM first with templates/deploy/bootstrap-vibly-indexer-vm.sh.
GCP_VIBLY_INDEXER_VM=vibly-indexer-vm
GCP_VIBLY_INDEXER_ZONE=
GCP_VIBLY_INDEXER_DEPLOY_MODE=remote-build
GCP_VIBLY_INDEXER_REMOTE_DIR=/opt/vibly/vibly-indexer
GCP_VIBLY_INDEXER_ENDPOINT=ws://127.0.0.1:9944
GCP_VIBLY_INDEXER_CHAIN_ID=substrate:vibly-solo
GCP_VIBLY_INDEXER_START_BLOCK=1

# Example plans:
# pnpm deploy:gcp:plan
# pnpm deploy:gcp -- --only=vibly-chain,vibly-indexer,vibly-coordinator,vibly-console
#
# Public network reminder:
# - Lumen uses Paseo RPCs for Get VIB relay-side deposits
# - Monolith uses Polkadot mainnet RPCs
# Neither environment needs a separately deployed local payment chain.
