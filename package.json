{
  "name": "vibly-e2e-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "e2e:local": "tsx --env-file=.env src/runner.ts",
    "e2e:stop": "tsx --env-file=.env src/stop.ts",
    "e2e:local:mock-stake": "VIBLY_E2E_MOCK_STAKE=true tsx --env-file=.env src/runner.ts",
    "e2e:local:no-console": "VIBLY_E2E_SKIP_CONSOLE=true tsx --env-file=.env src/runner.ts",
    "e2e:live-llm": "VIBLY_E2E_COORDINATOR_START_TIMEOUT_MS=240000 VIBLY_E2E_KEEP_ALIVE_ON_SUCCESS=true tsx --env-file=.env src/live-vibing-math.ts",
    "e2e:live-llm:ci": "tsx --env-file=.env src/live-vibing-math.ts",
    "e2e:live-llm:fresh": "VIBLY_E2E_COORDINATOR_START_TIMEOUT_MS=240000 VIBLY_E2E_RESET_RUN=true VIBLY_E2E_KEEP_ALIVE_ON_SUCCESS=true tsx --env-file=.env src/live-vibing-math.ts",
    "e2e:live-llm:resume": "VIBLY_E2E_COORDINATOR_START_TIMEOUT_MS=240000 VIBLY_E2E_RESUME=true VIBLY_E2E_KEEP_ALIVE_ON_SUCCESS=true tsx --env-file=.env src/live-vibing-math.ts",
    "e2e:live-llm:get-vib-local": "VIBLY_E2E_ENABLE_GET_VIB_LOCAL=true VIBLY_E2E_COORDINATOR_START_TIMEOUT_MS=240000 VIBLY_E2E_KEEP_ALIVE_ON_SUCCESS=true tsx --env-file=.env src/live-vibing-math.ts",
    "e2e:live-llm:resume:get-vib-local": "VIBLY_E2E_ENABLE_GET_VIB_LOCAL=true VIBLY_E2E_COORDINATOR_START_TIMEOUT_MS=240000 VIBLY_E2E_RESUME=true VIBLY_E2E_KEEP_ALIVE_ON_SUCCESS=true tsx --env-file=.env src/live-vibing-math.ts",
    "e2e:live-llm:testnet": "VIBLY_E2E_EXTERNAL_COORDINATOR=true VIBLY_E2E_EXTERNAL_CHAIN=true VIBLY_E2E_EXTERNAL_INDEXER=true VIBLY_E2E_KEEP_ALIVE_ON_SUCCESS=true tsx --env-file=.env src/live-vibing-math.ts",
    "e2e:get-vib": "tsx --env-file=.env src/get-vib.ts",
    "e2e:get-vib:polkadot-local": "tsx --env-file=.env src/get-vib-polkadot-local.ts",
    "e2e:stake": "tsx --env-file=.env src/stakeScenarios.ts",
    "e2e:stake:unbond": "VIBLY_E2E_UNBOND=true tsx --env-file=.env src/stakeScenarios.ts",
    "e2e:stake:stale-indexer": "VIBLY_E2E_STALE_INDEXER=true tsx --env-file=.env src/stakeScenarios.ts",
    "e2e:console": "playwright test",
    "test": "vitest run --exclude \"tests/**\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@polkadot/api": "^16.5.6",
    "@polkadot/keyring": "^14.0.3",
    "@polkadot/util-crypto": "^14.0.3",
    "@vibly/coordinator-http-contract": "file:../vibly-coordinator-http-contract",
    "openai": "^6.37.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.15.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
