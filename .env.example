# Copy this file to .env and fill in your values.
# .env is gitignored and never committed.

# ── Semi-autonomous LLM mode (Phase D) ─────────────────────────────────────────
# Leave OPENAI_API_KEY unset (or blank) to skip semi-autonomous mode entirely.

# DeepSeek (recommended):
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat

# OpenAI (alternative):
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# ── Coordinator / Console ports (optional overrides) ───────────────────────────
# VIBLY_E2E_COORDINATOR_PORT=8787
# VIBLY_E2E_CONSOLE_PORT=3001
# VIBLY_E2E_CONSOLE_START_TIMEOUT_MS=240000
# VIBLY_E2E_SKIP_CONSOLE=false
# VIBLY_E2E_EXTERNAL_COORDINATOR=false

# ── Live LLM persistent mode ──────────────────────────────────────────────────
# VIBLY_E2E_RUN_NAME=live-vibing-math
# VIBLY_E2E_RESET_RUN=false
# VIBLY_E2E_PAUSE_AT=after-proposal
# VIBLY_E2E_AGENT_CHAIN_MAP={"observer-agent-1":{"identityId":"...","chainAgentId":"..."}}
# VIBLY_E2E_TESTNET_SEED=false
# VIBLY_E2E_CHAIN_RPC_URL=wss://testnet.example
# VIBLY_E2E_TESTNET_BOND_AMOUNT=100
# VIBLY_E2E_KEEP_ALIVE_ON_SUCCESS=true
# VIBLY_E2E_SKIP_CONSOLE=false

# ── Lumen VibMath live agent bootstrap ─────────────────────────────────────────
# One-command Lumen testnet VibMath bootstrap:
# pnpm e2e:vibmath:lumen

# Required for Lumen mode.
# LUMEN_COORDINATOR_URL=https://...
# LUMEN_CHAIN_RPC_URL=wss://...
# LUMEN_INDEXER_GRAPHQL_URL=https://.../graphql

# Coordinator auth token.
# COORDINATOR_API_TOKEN=

# Chain id used when registering coordinator AgentProfile stake projection.
# VIBLY_E2E_CHAIN_ID=substrate:lumen

# Root/operator signer used by vibly-client CLI for chain registration and bond.
# Do not commit real values.
# VIBLY_E2E_ROOT_SIGNER_URI=

# Bond amount for each agent.
# VIBLY_E2E_TESTNET_BOND_AMOUNT=100

# Optional named run. Required for resume/pause-agent commands.
# VIBLY_E2E_RUN_NAME=lumen-vibmath-dev

# If true, seed chain identity/agent/bond through vibly-client CLI.
# VIBLY_E2E_TESTNET_SEED=true

# Reuse one existing identity for multiple chain agents.
# When set, each agent still registers its own chain agent and bonds independently.
# VIBLY_E2E_SHARED_IDENTITY_ID=

# Optional existing per-agent chain binding map.
# If both identityId and chainAgentId are present, the script reuses both and does not seed that agent.
# If only identityId is present, the script reuses the identity and registers a new chain agent.
# VIBLY_E2E_AGENT_CHAIN_MAP={"observer-agent-1":{"identityId":"..."}}

# Optional names.
# VIBLY_E2E_ORG_NAME=Lumen VibMath
# VIBLY_E2E_PROJECT_NAME=Lumen Goldbach Program
# VIBLY_E2E_PROJECT_SLUG_PREFIX=lumen-goldbach

# Keep services running after success for inspection.
# VIBLY_E2E_KEEP_ALIVE_ON_SUCCESS=true

# Skip local Console if only testing coordinator/agent flow.
# VIBLY_E2E_SKIP_CONSOLE=false

# ── Lumen identity / agent cache ───────────────────────────────────────────────
# Local cache directory for Lumen VibMath identity and agent keys.
# Defaults to ~/.vibly-e2e-lab/lumen-vibmath
# VIBLY_E2E_LUMEN_CACHE_DIR=

# Minimum required balance before agents are registered and bonded.
# If unset, the script computes: agentCount * bondAmount + fee buffer.
# VIBLY_E2E_LUMEN_REQUIRED_MIN_BALANCE=

# Fee buffer ratio used when calculating minimum required balance (default 0.1).
# VIBLY_E2E_LUMEN_FEE_BUFFER_RATIO=0.1

# Bond amount per agent.
# VIBLY_E2E_TESTNET_BOND_AMOUNT=100

# Do not run agents if local cache and chain state differ.
# VIBLY_E2E_LUMEN_FAIL_ON_DIFF=true

# ── Lumen attach mode ──────────────────────────────────────────────────────────
# Lumen E2E does not create organizations.
# Create the organization/project from Console as a human Guardian first,
# then attach the run to those IDs.
# VIBLY_E2E_SKIP_ORGANIZATION_CREATE=true
# VIBLY_E2E_ORGANIZATION_ID=
# VIBLY_E2E_PROJECT_ID=
# VIBLY_E2E_BOOTSTRAP_PRINCIPAL_ID=principal_e2e_bootstrap_lumen_vibmath

# Allow registering missing chain agents from local cache.
# VIBLY_E2E_LUMEN_REGISTER_MISSING_AGENTS=true

# Allow bonding missing agent stake.
# VIBLY_E2E_LUMEN_BOND_MISSING_AGENTS=true

# Allow topping up an already-active agent whose active amount is below expected.
# Default false.
# VIBLY_E2E_LUMEN_ALLOW_TOPUP_BOND=false

# Skip Lumen preflight before pnpm e2e:vibmath:lumen.
# Use only for debugging.
# VIBLY_E2E_SKIP_LUMEN_PREFLIGHT=false
